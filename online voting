  void swap(int i,int j)
  {
  int temp=contst[i].votes;
  char b[20];
  strcpy(b,contst[i].contestent_name);
  strcpy(contst[i].contestent_name,contst[j].contestent_name);
  strcpy(contst[j].contestent_name,b);
  contst[i].votes=contst[j].votes;
  contst[j].votes=temp;
  }
  int partition(int lb,int hb){
  int i=lb,j=hb+1;
  int pivot=contst[lb].votes;

  while (i < j){
  while (i<hb && contst[++i].votes<pivot);
  while (j>lb && contst[--j].votes>pivot);

  if (i<j) {
      swap(i,j);
  }
  }

  swap(lb,j);
  return j;
}
void quicksort(int lb, int hb)
{
   if (lb<hb)
    {
   int pivot_pos=partition(lb,hb);
   quicksort(lb,pivot_pos-1);
   quicksort(pivot_pos+1,hb);
   }
}
long int voterid_generate()
{
    int n,c=0;
    long int x=MAXVOTERS;
    while(x>=0)
    {
        x=x/10;
        c=c+1;
    }
    return VOTERS_ID_STARTWITH*pow(10,c);
    
}
