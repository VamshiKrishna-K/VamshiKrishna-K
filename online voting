	  if(c!=-1)
	  { Count=1;
	    t=contestent;
	  while(c!=Count)
	  {t=t->link;Count=Count+1;}
          t->votes=t->votes+1;
          contst[c-1].votes=contst[c-1].votes+1;
          printf("You %s voted to %s\n",voter[index].voter_name,t->contestent_name);
          }
          else
