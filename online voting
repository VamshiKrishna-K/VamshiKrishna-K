  void voters_analysis(){
      char a[10];
      int v=0,nv=0,N=0,i;
      float p;
      printf("\n---------------Voters Data Analysis-----------\n");
      printf("Voters             \n");

      for(i=Voter_top;i>=0;i--)
      {  if(voter[i].isvote==1)
	   {strcpy(a,"VOTED"),v++;}
	  else if(voter[i].isvote==0)
	  {strcpy(a,"NOT VOTED"),nv++;}
	  else
	  {strcpy(a,"NOTA"),N++;}
	  printf("%-10s%s\n",voter[i].voter_name,a);
      }
      p=(float)((((v+N)*100)/Total_voters));
      printf("\n-----------------------------------------------------\n");
      printf("Total voters              :%d\n",Total_voters);
      printf("Total people voted        :%d\n",v);
      printf("Total people not voted    :%d\n",nv);
      printf("Toatl people voted to NOTA:%d\n",N);
      printf("-------------------------------------------------------\n");
      printf("Voting percentage         :%.2f\n",p);


  }
