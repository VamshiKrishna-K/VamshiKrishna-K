  void withdrawal(int pos)
  {
      int count=1;
      if(pos==1)
      {
      struct contestents *temp=contestent;
      contestent=(struct contestents*)contestent->link;
      temp->link=NULL;
      free(temp);
      }
      else if(pos==contestent_count)
      {
      struct contestents *k=contestent,*v;
      while(k->link!=NULL)
      {v=k;
       k=k->link;}
      v->link=NULL;
      free(k);
      }
      else
      {
      struct contestents *temp=contestent,*k;
      while(count!=pos)
      {
	    k=temp;
	    temp=temp->link;
	    count++;
      }
      k->link=temp->link;
      temp->link=NULL;
      contestent_count=contestent_count-1;
      free(temp);
      }

  }
